+/**
+ * Defines the status domains of an AMWA BCP-008 monitor that the
+ * application reports. A Receiver's monitor (NcReceiverMonitor,
+ * BCP-008-01) and a Sender's monitor (NcSenderMonitor, BCP-008-02)
+ * each have four; the overall status is derived from them.
+ */
+typedef enum _NvNmosMonitorDomain
+{
+    /** linkStatus of either monitor; status is one of
+        NVNMOS_LINK_STATUS_*. */
+    NVNMOS_MONITOR_DOMAIN_LINK = 1,
+    /** connectionStatus of a Receiver's monitor, transmissionStatus of
+        a Sender's monitor; status is one of NVNMOS_MONITOR_STATUS_*. */
+    NVNMOS_MONITOR_DOMAIN_CONNECTION = 2,
+    /** externalSynchronizationStatus of either monitor; status is one
+        of NVNMOS_SYNCHRONIZATION_STATUS_*. */
+    NVNMOS_MONITOR_DOMAIN_SYNCHRONIZATION = 3,
+    /** streamStatus of a Receiver's monitor, essenceStatus of a
+        Sender's monitor; status is one of NVNMOS_MONITOR_STATUS_*. */
+    NVNMOS_MONITOR_DOMAIN_STREAM = 4
+} NvNmosMonitorDomain;
+
+/**
+ * Defines the values of the BCP-008 connection, transmission, stream
+ * and essence statuses.
+ */
+enum {
+    NVNMOS_MONITOR_STATUS_INACTIVE = 0,
+    NVNMOS_MONITOR_STATUS_HEALTHY = 1,
+    NVNMOS_MONITOR_STATUS_PARTIALLY_HEALTHY = 2,
+    NVNMOS_MONITOR_STATUS_UNHEALTHY = 3
+};
+
+/**
+ * Defines the values of the BCP-008 link status.
+ */
+enum {
+    NVNMOS_LINK_STATUS_ALL_UP = 1,
+    NVNMOS_LINK_STATUS_SOME_DOWN = 2,
+    NVNMOS_LINK_STATUS_ALL_DOWN = 3
+};
+
+/**
+ * Defines the values of the BCP-008 external synchronization status.
+ */
+enum {
+    NVNMOS_SYNCHRONIZATION_STATUS_NOT_USED = 0,
+    NVNMOS_SYNCHRONIZATION_STATUS_HEALTHY = 1,
+    NVNMOS_SYNCHRONIZATION_STATUS_PARTIALLY_HEALTHY = 2,
+    NVNMOS_SYNCHRONIZATION_STATUS_UNHEALTHY = 3
+};
+
+/**
+ * Defines which counters a Controller asks a monitor for.
+ */
+typedef enum _NvNmosMonitorCounters
+{
+    /** GetLostPacketCounters of a Receiver's monitor. */
+    NVNMOS_MONITOR_COUNTERS_LOST = 1,
+    /** GetLatePacketCounters of a Receiver's monitor. */
+    NVNMOS_MONITOR_COUNTERS_LATE = 2,
+    /** GetTransmissionErrorCounters of a Sender's monitor. */
+    NVNMOS_MONITOR_COUNTERS_TRANSMISSION_ERROR = 3
+} NvNmosMonitorCounters;
+
+/**
+ * Holds one counter of a monitor (NcCounter).
+ */
+typedef struct _NvNmosMonitorCounter
+{
+    /** Holds the name of the counter. Must not be null. */
+    const char *name;
+    /** Holds the value of the counter. */
+    uint64_t value;
+    /** Holds the description of the counter. May be null. */
+    const char *description;
+} NvNmosMonitorCounter;
+
+/**
+ * Type for a callback from NvNmos when a Controller asks a monitor for
+ * its counters.
+ *
+ * Invoked on a thread of the IS-12 server, with the Node's model
+ * locked: it must not block and must not call back into NvNmos.
+ *
