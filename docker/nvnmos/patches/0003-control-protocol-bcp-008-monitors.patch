+    void server::insert_device_model()
+    {
+        if (!control_protocol_state) return;
+
+        auto lock = node_model.write_lock();
+
+        auto root_block = nmos::make_root_block();
+        auto device_manager = nmos::make_device_manager(++next_oid, node_model.settings);
+        auto class_manager = nmos::make_class_manager(++next_oid, *control_protocol_state);
+        receiver_monitors_oid = ++next_oid;
+        auto receiver_monitors = nmos::make_block(receiver_monitors_oid, nmos::root_block_oid, U("receiver-monitors"), U("Receiver Monitors"), U("Receiver Monitors"));
+        sender_monitors_oid = ++next_oid;
+        auto sender_monitors = nmos::make_block(sender_monitors_oid, nmos::root_block_oid, U("sender-monitors"), U("Sender Monitors"), U("Sender Monitors"));
+
+        nmos::nc::push_back(root_block, device_manager);
+        nmos::nc::push_back(root_block, class_manager);
+        nmos::nc::push_back(root_block, receiver_monitors);
+        nmos::nc::push_back(root_block, sender_monitors);
+        nmos::nc::insert_root(node_model.control_protocol_resources, root_block);
+
+        node_model.notify();
+    }
+
+    // Gives every sender and receiver a monitor and removes the monitors of those that are gone.
+    void server::update_monitors()
+    {
+        if (!control_protocol_state) return;
+
+        auto lock = node_model.write_lock();
+
+        update_monitors(nmos::types::sender, sender_monitors_oid);
+        update_monitors(nmos::types::receiver, receiver_monitors_oid);
+
+        node_model.notify();
+    }
+
+    void server::update_monitors(const nmos::type& type, nmos::nc_oid block_oid)
+    {
+        using web::json::value;
+        using web::json::value_of;
+
+        auto& resources = node_model.control_protocol_resources;
+        const bool sender = nmos::types::sender == type;
+        const auto touchpoint_type = sender ? nmos::ncp_touchpoint_resource_types::sender : nmos::ncp_touchpoint_resource_types::receiver;
+        bool changed = false;
+
+        for (const auto& resource : node_model.node_resources)
+        {
+            if (type != resource.type || !resource.has_data()) continue;
+            if (resources.end() != nmos::nc::find_resource(resources, nmos::types::nc_status_monitor, resource.id)) continue;
+
+            const auto oid = ++next_oid;
+            const auto role = (sender ? U("sender-monitor-") : U("receiver-monitor-")) + impl::get_name(resource);
+            const auto touchpoints = value_of({ nmos::nc::details::make_touchpoint_nmos({ touchpoint_type, resource.id }) });
+            auto monitor = sender
+                ? nmos::make_sender_monitor(oid, true, block_oid, role, nmos::fields::label(resource.data), nmos::fields::description(resource.data), touchpoints)
+                : nmos::make_receiver_monitor(oid, true, block_oid, role, nmos::fields::label(resource.data), nmos::fields::description(resource.data), touchpoints);
+            nmos::nc::insert_resource(resources, std::move(monitor));
+            changed = true;
+        }
+
+        std::vector<nmos::id> gone;
+        for (const auto& monitor : resources)
+        {
+            if (nmos::types::nc_status_monitor != monitor.type || !monitor.has_data()) continue;
+            if (block_oid != nmos::fields::nc::owner(monitor.data)) continue;
+            const auto& touchpoints = nmos::fields::nc::touchpoints(monitor.data);
+            const bool target_exists = 0 != touchpoints.size()
+                && node_model.node_resources.end() != nmos::find_resource(node_model.node_resources, { nmos::fields::nc::id(nmos::fields::nc::resource(touchpoints.at(0))).as_string(), type });
+            if (!target_exists) gone.push_back(monitor.id);
+        }
+        for (const auto& id : gone)
+        {
+            nmos::nc::erase_resource(resources, id);
+            changed = true;
+        }
+
+        if (!changed) return;
+
+        // the block's members are its monitors, in order of their oids
+        auto members = value::array();
+        for (const auto& monitor : resources)
+        {
+            if (nmos::types::nc_status_monitor != monitor.type || !monitor.has_data()) continue;
+            if (block_oid != nmos::fields::nc::owner(monitor.data)) continue;
+            web::json::push_back(members, nmos::nc::details::make_block_member_descriptor(nmos::fields::description(monitor.data), nmos::fields::nc::role(monitor.data), nmos::fields::nc::oid(monitor.data), true, nmos::nc::details::parse_class_id(nmos::fields::nc::class_id(monitor.data)), nmos::fields::nc::user_label(monitor.data), block_oid));
+        }
+        nmos::nc::modify_resource(resources, utility::conversions::details::to_string_t(block_oid), [&](nmos::resource& block)
+        {
+            block.data[nmos::fields::nc::members] = members;
+        }, nmos::nc::make_property_changed_event(block_oid, { { nmos::nc_block_members_property_id, nmos::nc_property_change_type::type::value_changed, members } }));
+    }
+
+    // An activation through nmos_connection_activate does not pass the connection activation thread, which activates monitors.
+    void server::activate_monitor(const nmos::type& type, const nvnmos::name& name)
+    {
+        if (!control_protocol_state) return;
+
+        auto lock = node_model.write_lock();
+
+        const auto id = impl::make_id(nmos::experimental::fields::seed_id(node_model.settings), type, name);
+        const auto resource = nmos::find_resource(node_model.node_resources, { id, type });
+        const auto connection_resource = nmos::find_resource(node_model.connection_resources, { id, type });
+        if (node_model.node_resources.end() == resource || node_model.connection_resources.end() == connection_resource) return;
+
+        monitor_activated(*resource, *connection_resource);
+
+        node_model.notify();
+    }
+
+    bool server::find_monitor_target(const nmos::resource& monitor, NvNmosSide& side, std::string& name) const
+    {
+        const auto& touchpoints = nmos::fields::nc::touchpoints(monitor.data);
+        if (0 == touchpoints.size()) return false;
+        const auto& id = nmos::fields::nc::id(nmos::fields::nc::resource(touchpoints.at(0))).as_string();
+        for (const auto& type : { nmos::types::sender, nmos::types::receiver })
+        {
+            const auto resource = nmos::find_resource(node_model.node_resources, { id, type });
+            if (node_model.node_resources.end() == resource) continue;
+            side = side_from_type(type);
+            name = utility::us2s(impl::get_name(*resource));
+            return true;
+        }
+        return false;
+    }
+
+    std::vector<nmos::nc::counter> server::monitor_counters(const nmos::resource& monitor, NvNmosMonitorCounters which) const
+    {
+        std::vector<nmos::nc::counter> result;
+        NvNmosSide side;
+        std::string name;
+        if (!control_config.get_counters || !find_monitor_target(monitor, side, name)) return result;
+
+        NvNmosMonitorCounter counters[32] = {};
+        const auto count = std::min(control_config.get_counters(c_server, side, name.c_str(), which, counters, 32), size_t(32));
+        for (size_t index = 0; index < count; ++index)
+        {
+            if (!counters[index].name) continue;
+            result.push_back({ utility::s2us(counters[index].name), counters[index].value, utility::s2us(counters[index].description) });
+        }
+        return result;
+    }
+
+    void server::reset_monitor_counters(const nmos::resource& monitor) const
+    {
+        NvNmosSide side;
+        std::string name;
+        if (!control_config.reset_counters || !find_monitor_target(monitor, side, name)) return;
+        control_config.reset_counters(c_server, side, name.c_str());
+    }
+
+    void server::set_monitor_status(const nmos::type& type, const std::string& name, NvNmosMonitorDomain domain, int status, const std::string& message)
+    {
+        try
+        {
+            if (!control_protocol_state) throw std::logic_error("server created without the control protocol");
+
+            auto lock = node_model.write_lock();
+
+            auto& resources = node_model.control_protocol_resources;
+            const auto id = impl::make_id(nmos::experimental::fields::seed_id(node_model.settings), type, utility::s2us(name));
+            const auto monitor = nmos::nc::find_resource(resources, nmos::types::nc_status_monitor, id);
+            if (resources.end() == monitor) throw std::invalid_argument("Could not find the monitor of " + utility::us2s(type.name) + ": " + name);
+
+            const auto oid = nmos::fields::nc::oid(monitor->data);
+            const auto class_id = nmos::nc::details::parse_class_id(nmos::fields::nc::class_id(monitor->data));
+            const bool sender = nmos::nc::is_sender_monitor(class_id);
+            const auto status_property_id = [&]
+            {
+                switch (domain)
+                {
+                case NVNMOS_MONITOR_DOMAIN_LINK: return sender ? nmos::nc_sender_monitor_link_status_property_id : nmos::nc_receiver_monitor_link_status_property_id;
+                case NVNMOS_MONITOR_DOMAIN_CONNECTION: return sender ? nmos::nc_sender_monitor_transmission_status_property_id : nmos::nc_receiver_monitor_connection_status_property_id;
+                case NVNMOS_MONITOR_DOMAIN_SYNCHRONIZATION: return sender ? nmos::nc_sender_monitor_external_synchronization_status_property_id : nmos::nc_receiver_monitor_external_synchronization_status_property_id;
+                case NVNMOS_MONITOR_DOMAIN_STREAM: return sender ? nmos::nc_sender_monitor_essence_status_property_id : nmos::nc_receiver_monitor_stream_status_property_id;
+                }
+                throw std::invalid_argument("invalid NvNmosMonitorDomain");
+            }();
+            const auto domains = nmos::nc::get_monitor_domains(class_id, nmos::make_get_monitor_domains_handler(*control_protocol_state));
+            const auto found = std::find_if(domains.begin(), domains.end(), [&](const nmos::experimental::monitor_domain& d) { return status_property_id == d.status_property_id; });
+            if (domains.end() == found) throw std::invalid_argument("invalid NvNmosMonitorDomain");
+
+            const bool applied = nmos::nc::set_monitor_status(resources, oid, status, utility::s2us(message), *found,
+                nmos::make_monitor_status_pending_handler(*control_protocol_state),
+                nmos::make_get_control_protocol_class_descriptor_handler(*control_protocol_state),
+                nmos::make_get_monitor_domains_handler(*control_protocol_state),
+                gate);
+            if (!applied) throw std::invalid_argument("Could not set the status of the monitor of " + utility::us2s(type.name) + ": " + name);
+
+            node_model.notify();
+        }
+        catch (...)
+        {
+            log_current_exception();
+            throw;
+        }
+    }
