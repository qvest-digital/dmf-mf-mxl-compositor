+NVNMOS_API
+bool nmos_monitor_set_status(
+    NvNmosNodeServer* server,
+    NvNmosSide side,
+    const char* name,
+    NvNmosMonitorDomain domain,
+    int status,
+    const char* message)
+{
+    if (!server) return false;
+    auto impl = (nvnmos::server*)server->impl;
+    if (!impl) return false;
+    if (!name) return false;
+
+    try
+    {
+        const auto type = nvnmos::type_from_side(side);
+        impl->set_monitor_status(type, name, domain, status, message ? message : "");
+        return true;
+    }
+    catch (...)
+    {
+        return false;
+    }
